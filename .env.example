# Copie este arquivo para .env e preencha.

# O jeito mais fácil de preencher este arquivo: python -m jarvis --configurar
# (o instalar_jarvis.bat já faz isso).

# Cérebro GRÁTIS: chave do Google Gemini, crie em https://aistudio.google.com/apikey
GEMINI_API_KEY=
JARVIS_IA=gemini
JARVIS_MODELO_GEMINI=gemini-flash-latest
# Usado quando o principal está sobrecarregado (o JARVIS troca sozinho)
JARVIS_MODELO_GEMINI_RESERVA=gemini-flash-lite-latest

# Opcional e PAGO por uso: Claude (https://console.anthropic.com). Para usar, coloque JARVIS_IA=claude
# ANTHROPIC_API_KEY=sk-ant-...

# Gmail (ler e enviar e-mails) com senha de app: python -m jarvis --gmail preenche isto.
# Crie a senha em https://myaccount.google.com/apppasswords (precisa da verificação em 2 etapas).
GMAIL_ENDERECO=
GMAIL_SENHA_APP=

# Como o JARVIS deve chamar você
JARVIS_NOME_USUARIO=senhor
# Sua cidade (ajuda em clima, notícias locais etc.)
JARVIS_CIDADE=

# Palavra de ativação no modo voz
JARVIS_PALAVRA_ATIVACAO=jarvis
# Voz neural (dá para trocar e testar pela tela, no botão Voz).
# Outras: pt-BR-FranciscaNeural, pt-BR-ThalitaMultilingualNeural, en-US-BrianMultilingualNeural
JARVIS_VOZ=pt-BR-AntonioNeural
# Velocidade em % (ex.: 6 = 6% mais rápido) e tom em Hz (negativo = mais grave)
JARVIS_VOZ_VELOCIDADE=6
JARVIS_VOZ_TOM=-3

# Só para o Claude: modelo e esforço de raciocínio (low = mais rápido; high = pensa mais)
JARVIS_MODELO=claude-opus-5-5
JARVIS_ESFORCO=medium

# Deixar o JARVIS ver a tela e usar mouse e teclado (pede autorização uma vez por pedido)
JARVIS_CONTROLE_PC=true
# WhatsApp: true = aperta Enter e envia sozinho; false = só deixa a mensagem pronta
JARVIS_WHATSAPP_ENVIAR_SOZINHO=true

# Permitir pesquisa na web (true/false)
JARVIS_PESQUISA_WEB=true

# Pastas extras (além da sua pasta de usuário) que o JARVIS pode acessar, separadas por ;
# Ex.: D:\Projetos;E:\Fotos
JARVIS_PASTAS_PERMITIDAS=
